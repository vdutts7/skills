{
  "_about": "X/Twitter GraphQL + v1.1 API registry",
  "_last_recon": "05-14-26",
  "_cross_ref": {
    "skill": "SKILL.md",
    "script": "scripts/twittercli.py"
  },

  "base_url": "https://api.x.com",
  "bearer": "AAAAAAAAAAAAAAAAAAAAANRILgAAAAAAnNwIzUejRCOuH5E6I8xnZz4puTs=1Zv7ttfk8LF81IUq16cHjhLTvJu4FA33AGWWjCpTnA",
  "js_bundle_url": "https://abs.twimg.com/responsive-web/client-web/main.{hash}.js",
  "js_bundle_discovery": "GET https://x.com/ -> grep for main.*.js URL",
  "qid_extraction_regex": "queryId:\"([^\"]+)\",operationName:\"([^\"]+)\"",

  "auth": {
    "guest_token": {
      "endpoint": "POST /1.1/guest/activate.json",
      "header": "x-guest-token",
      "ttl_seconds": 900,
      "rotation_every_n_requests": 15,
      "binding": "since Jan 2025, guest tokens bound to browser fingerprints"
    },
    "cookie_boost": {
      "cookies": ["auth_token", "ct0"],
      "header": "x-csrf-token: {ct0}",
      "unlocks": ["TweetDetail", "SearchTimeline", "pagination_cursors", "thread_replies"]
    }
  },

  "endpoints": {
    "graphql": {
      "UserByScreenName": {
        "qid": "IGgvgiOx4QZndDHuD3x9TQ",
        "method": "GET",
        "guest": true,
        "variables": {"screen_name": "HANDLE", "withSafetyModeUserFields": true},
        "features": "FEATURES_USER",
        "response_path": "data.user.result",
        "field_locations": {
          "name": "core.name",
          "screen_name": "core.screen_name",
          "created_at": "core.created_at",
          "description": "legacy.description",
          "followers_count": "legacy.followers_count",
          "friends_count": "legacy.friends_count",
          "statuses_count": "legacy.statuses_count",
          "avatar": "avatar.image_url",
          "location": "location.location",
          "banner": "legacy.profile_banner_url",
          "verified": "is_blue_verified",
          "rest_id": "rest_id"
        }
      },
      "UserTweets": {
        "qid": "36rb3Xj3iJ64Q-9wKDjCcQ",
        "method": "GET",
        "guest": true,
        "variables": {"userId": "UID", "count": 100, "includePromotedContent": false, "withQuickPromoteEligibilityTweetFields": true, "withVoice": true, "withV2Timeline": true},
        "response_path": "data.user.result.timeline.timeline.instructions[].entries[].content.itemContent.tweet_results.result",
        "guest_limits": {
          "max_tweets": 99,
          "pagination": false,
          "cursor": "not returned for guest tokens",
          "sort": "engagement (not chronological)"
        }
      },
      "TweetResultByRestId": {
        "qid": "2Acdg-VztGlHX7MjX67Ysw",
        "method": "GET",
        "guest": "partial (intermittent per-tweet, ~85% success)",
        "variables": {"tweetId": "ID", "withCommunity": false, "includePromotedContent": false, "withVoice": false},
        "response_path": "data.tweetResult.result"
      },
      "TweetDetail": {
        "qid": "oCon7R-cgWRFy6EfZjaKfg",
        "method": "GET",
        "guest": false,
        "guest_response": "403 or 503",
        "requires": "cookie_boost",
        "returns": "focal tweet + threaded replies"
      },
      "SearchTimeline": {
        "qid": "Yw6L66Pw54NHKuq4Dp7b4Q",
        "method": "GET",
        "guest": false,
        "guest_response": "404",
        "requires": "cookie_boost",
        "variables": {"rawQuery": "QUERY", "count": 20, "querySource": "typed_query", "product": "Latest"}
      }
    },
    "v1_1": {
      "guest_activate": {
        "path": "/1.1/guest/activate.json",
        "method": "POST",
        "guest": true
      },
      "trends_place": {
        "path": "/1.1/trends/place.json",
        "method": "GET",
        "guest": true,
        "params": {"id": "WOEID"},
        "returns": "50 trends per location"
      }
    },
    "third_party": {
      "fxtwitter": {
        "base": "https://api.fxtwitter.com",
        "pattern": "/{handle}/status/{id}",
        "auth": "none",
        "returns": "full tweet with bookmarks, source, lang, full author object",
        "fields": ["id","text","likes","retweets","replies","quotes","bookmarks","views","created_at","source","lang","is_note_tweet","community_note","replying_to","author.followers","author.verified","author.joined","media"],
        "reliability": "intermittent per-tweet (~85%), different failure set than GQL",
        "cascade_priority": 1
      }
    }
  },

  "features_blobs": {
    "FEATURES": "{\"rweb_tipjar_consumption_enabled\":true,\"responsive_web_graphql_exclude_directive_enabled\":true,\"verified_phone_label_enabled\":false,\"creator_subscriptions_tweet_preview_api_enabled\":true,\"responsive_web_graphql_timeline_navigation_enabled\":true,\"responsive_web_graphql_skip_user_profile_image_extensions_enabled\":false,\"communities_web_enable_tweet_community_results_fetch\":true,\"c9s_tweet_anatomy_moderator_badge_enabled\":true,\"articles_preview_enabled\":true,\"responsive_web_edit_tweet_api_enabled\":true,\"graphql_is_translatable_rweb_tweet_is_translatable_enabled\":true,\"view_counts_everywhere_api_enabled\":true,\"longform_notetweets_consumption_enabled\":true,\"responsive_web_twitter_article_tweet_consumption_enabled\":true,\"tweet_awards_web_tipping_enabled\":false,\"freedom_of_speech_not_reach_fetch_enabled\":true,\"standardized_nudges_misinfo\":true,\"tweet_with_visibility_results_prefer_gql_limited_actions_policy_enabled\":true,\"longform_notetweets_rich_text_read_enabled\":true,\"longform_notetweets_inline_media_enabled\":true,\"responsive_web_enhance_cards_enabled\":false}",
    "FEATURES_USER": "{\"hidden_profile_subscriptions_enabled\":true,\"rweb_tipjar_consumption_enabled\":true,\"responsive_web_graphql_exclude_directive_enabled\":true,\"verified_phone_label_enabled\":false,\"subscriptions_verification_info_is_identity_verified_enabled\":true,\"subscriptions_verification_info_verified_since_enabled\":true,\"highlights_tweets_tab_ui_enabled\":true,\"responsive_web_twitter_article_notes_tab_enabled\":true,\"subscriptions_feature_can_gift_premium\":true,\"creator_subscriptions_tweet_preview_api_enabled\":true,\"responsive_web_graphql_skip_user_profile_image_extensions_enabled\":false,\"responsive_web_graphql_timeline_navigation_enabled\":true}"
  },

  "search_engines": {
    "ddg": {
      "package": "ddgs",
      "query_template": "site:x.com {query}",
      "max_results_effective": 22,
      "rotation_keywords": ["", "2025", "2024", "2026", "thread", "announcement", "opinion", "news", "update", "release", "AI", "launch", "guide", "analysis"],
      "stale_threshold": 3,
      "rate_limit": "transient, retry with backoff"
    }
  },

  "woeids": {
    "worldwide": 1,
    "us": 23424977,
    "new_york": 2459115,
    "los_angeles": 2442047,
    "san_francisco": 2487956,
    "chicago": 2379574,
    "london": 44418,
    "tokyo": 1118370,
    "paris": 615702,
    "berlin": 638242,
    "sydney": 1105779,
    "toronto": 4118,
    "mumbai": 2295411,
    "singapore": 1062617,
    "dubai": 1940345
  }
}
